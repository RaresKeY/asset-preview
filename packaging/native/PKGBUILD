# Binary repackaging for private downloads: download the matching portable
# archive and SHA256SUMS with gh first, then run makepkg in this directory.
pkgname=asset-preview
pkgver=0.0.2
pkgrel=1
pkgdesc='Live asset previews for AI agent workflows'
arch=('x86_64')
url='https://github.com/RaresKeY/asset-preview'
license=('MIT' 'custom:bundled-dependencies')
depends=('glibc>=2.39' 'libglvnd' 'fontconfig' 'ttf-dejavu')
options=('!strip' '!debug')
source=("asset-preview-${pkgver}-linux-x86_64.tar.gz")
# Supply the release archive's verified digest when generating this recipe.
sha256sums=('@ARCHIVE_SHA256@')
package() {
  install -d "$pkgdir/opt" "$pkgdir/usr/bin" "$pkgdir/usr/share/applications" \
    "$pkgdir/usr/share/icons/hicolor/scalable/apps" "$pkgdir/usr/share/metainfo" \
    "$pkgdir/usr/share/licenses/asset-preview" "$pkgdir/usr/share/doc/asset-preview"
  cp -a "$srcdir/asset-preview" "$pkgdir/opt/asset-preview"
  ln -s /opt/asset-preview/asset-preview "$pkgdir/usr/bin/asset-preview"
  install -m644 "$srcdir/asset-preview/desktop/"*.desktop "$pkgdir/usr/share/applications/"
  install -m644 "$srcdir/asset-preview/desktop/"*.xml "$pkgdir/usr/share/metainfo/"
  install -m644 "$srcdir/asset-preview/icon.svg" "$pkgdir/usr/share/icons/hicolor/scalable/apps/io.github.RaresKeY.AssetPreview.svg"
  install -m644 "$srcdir/asset-preview/LICENSE" "$pkgdir/usr/share/licenses/asset-preview/LICENSE"
  install -m644 "$srcdir/asset-preview/THIRD_PARTY_NOTICES.md" "$pkgdir/usr/share/doc/asset-preview/"
}
